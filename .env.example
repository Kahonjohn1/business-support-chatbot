# Google Gemini API configuration
# Copy this file to .env.local and fill in your own credentials.
# Do not commit your actual secrets.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: secondary model, tried once if the primary model fails with a
# recoverable provider/API error (rate limit, 5xx, transient network/timeout, or
# an unknown model name). Invalid requests, auth/permission errors, and
# unsupported/oversized files never trigger it. Leave unset to disable, or set it
# equal to GEMINI_MODEL to disable (a duplicate is ignored). A distinct fallback
# model from the same family is recommended.
# GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# Optional: cap on model output length (tokens). Invalid values fall back to the
# default (1024) and values above the hard ceiling (8192) are clamped.
# GEMINI_MAX_OUTPUT_TOKENS=1024

# Optional: best-effort, per-instance chat rate limit (see src/lib/rateLimit.ts).
# This is process-local and not distributed protection.
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_MS=60000

# Optional: trust client IP headers (x-forwarded-for / x-real-ip) for rate-limit
# bucketing. Enable ONLY when running behind a proxy you control that overwrites
# these headers; otherwise a directly exposed client can spoof them. When unset,
# all requests share a single rate-limit bucket.
# TRUST_PROXY=false
