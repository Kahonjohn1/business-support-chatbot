# Groq API configuration (https://console.groq.com/keys)
# Copy this file to .env.local and fill in your own credentials.
# Do not commit your actual secrets.

GROQ_API_KEY=
# NOTE: llama-3.3-70b-versatile and llama-3.1-8b-instant are Enterprise-tier
# ("Contact Sales") and return 404 on developer-plan keys; use models priced for
# the developer plan (see https://console.groq.com/docs/models).
GROQ_MODEL=openai/gpt-oss-120b

# Optional: secondary model, tried once if the primary model fails with a
# recoverable provider/API error (rate limit, 5xx, transient network/timeout, or
# an unknown model name). Invalid requests, auth/permission errors, and
# unsupported/oversized files never trigger it. Leave unset to disable, or set it
# equal to GROQ_MODEL to disable (a duplicate is ignored). A distinct fallback
# model from the same family is recommended.
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Optional: cap on model output length (tokens). Invalid values fall back to the
# default (1024) and values above the hard ceiling (8192) are clamped.
# GROQ_MAX_OUTPUT_TOKENS=1024

# Attachments: image attachments are routed to Groq's vision model
# (qwen/qwen3.8-27b), which accepts at most 3 images per request; images on
# older messages beyond that budget are omitted from the context. PDFs are not
# supported by Groq: a PDF on the newest message is rejected with a clear
# error, and PDFs on older messages are omitted. TXT, CSV, and DOCX files are
# sent as extracted text.

# Optional: best-effort, per-instance chat rate limit (see src/lib/rateLimit.ts).
# This is process-local and not distributed protection.
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_MS=60000

# Optional: trust client IP headers (x-forwarded-for / x-real-ip) for rate-limit
# bucketing. Enable ONLY when running behind a proxy you control that overwrites
# these headers; otherwise a directly exposed client can spoof them. When unset,
# all requests share a single rate-limit bucket.
# TRUST_PROXY=false

# Supabase configuration. Only public keys may use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternative to NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for older projects:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret keys must never use the NEXT_PUBLIC_ prefix:
# SUPABASE_SECRET_KEY=

# External integrations (server-only). Both Google providers share one callback URL.
# Register this exact URL as an authorized redirect URI in your OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/callback

# AES-256-GCM encryption key for integration tokens. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
INTEGRATION_TOKEN_ENCRYPTION_KEY=
# Optional previous key during rotation. Remove after all stored credentials
# have been re-encrypted under the current key.
INTEGRATION_TOKEN_ENCRYPTION_KEY_PREVIOUS=
# Comma-separated canonical app origins allowed for OAuth redirects.
# Production origins must use HTTPS.
INTEGRATION_APP_ORIGINS=http://localhost:3000
# Set to 1 only behind a trusted proxy that rewrites x-forwarded-for.
TRUST_PROXY=
