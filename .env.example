# Google Gemini API configuration
# Copy this file to .env.local and fill in your own credentials.
# Do not commit your actual secrets.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: best-effort, per-instance chat rate limit (see src/lib/rateLimit.ts).
# This is process-local and not distributed protection.
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_MS=60000
